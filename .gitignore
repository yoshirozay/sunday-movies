# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local enrichment cache — large, regenerable, and pulled from third-party
# APIs (TMDB + JustWatch) we don't have rights to redistribute. Each contributor
# regenerates this on their own machine via `npm run fetch-data`.
/.data-cache/

# NOTE: public/movies.json IS committed. It's the data file the deployed
# site reads at request time. Regenerate it locally with `npm run fetch-data`
# (or future `npm run refresh`), then commit + push to redeploy.

# Claude Code local tooling (launch config, worktrees, etc.) — not part of
# the project itself.
/.claude/
